<odoo>
    <record id="paperformat_euro_portrait" model="report.paperformat">
        <field name="name">European A4 Portrait</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="True"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="paperformat_euro_landscape" model="report.paperformat">
        <field name="name">European A4 Landscape</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="True" />
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <template id="report_nota_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <table class="table table-sm">
                    <thead>
                        <tr class="bg-primary">
                            <th class="text-left">Ano Académico</th>
                            <th class="text-left">Quenda</th>
                            <th class="text-left">Ciclo</th>
                            <th class="text-left">Curso</th>
                            <th class="text-left">Módulo</th>
                            <th class="text-left">Nota</th>
                            <th class="text-left">Nota Texto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="aprobados" t-value="0" />
                        <t t-set="suspensos" t-value="0" />
                        <t t-foreach="docs" t-as="o">
                            <tr>
                                <td class="text-left">
                                    <h5>
                                        <span t-field="o.ano_academico"/>
                                    </h5>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.quenda"/>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.ciclo"/>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.curso"/>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.modulo"/>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.nota"/>
                                    <t t-if="o.nota &gt;= 5">
                                        <t t-set="aprobados" t-value="aprobados + 1"/>
                                    </t>
                                    <t t-else="o.nota &lt;= 4">
                                        <t t-set="suspensos" t-value="suspensos + 1"/>
                                    </t>
                                </td>
                                <td class="text-left">
                                    <span t-field="o.nota_texto"/>
                                </td>
                            </tr>
                        </t>

                        <tr>
                            <td class="text-left">
                                <span>Total Suspensos:</span>
                            </td>
                            <td class="text-left">
                                <span t-esc="suspensos"/>
                            </td>
                            <td class="text-left">
                                <span>Total Aprobados:</span>
                            </td>
                            <td class="text-left">
                                <span t-esc="aprobados"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <record id="report_examen" model="ir.actions.report">
        <field name="name">Listaxe de Notas</field>
        <field name="model">odoo_examen_prueba2.nota</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_examen_prueba2.report_nota_template</field>
        <field name="report_file">odoo_examen_prueba2.report_nota_template</field>
        <!--        <field name="print_report_name">'Registration Event - %s' % (object.name or 'Attendee').replace('/','')</field>-->
        <field name="paperformat_id" ref="paperformat_euro_portrait"/>
        <field name="binding_model_id" ref="model_odoo_examen_prueba2_nota"/>
        <field name="binding_type">report</field>
    </record>
</odoo>